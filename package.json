{
  "name": "soren-loop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && node scripts/check-action-pins.mjs .github/workflows .github/actions/setup",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "env -u DATABASE_URL vitest run",
    "test:db": "pnpm --filter @sorenai/loop-server test:db",
    "ci": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
