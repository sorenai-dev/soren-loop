      "a",
      "\ue000",
      "\ufb01",
      "\ud83d\ude00"
    ],
    "expected_bytes_hex": "0000000a736c3a746573743a7631000000016100000003ee808000000003efac8100000004f09f9880",
    "expected_hash": "0bd8308268debc438dea72275e700f2d67dba2ef19e347d378f74951be480861"
  },
  {
    "id": "H-15",
    "description": "P(path): ./src/a.ts, src/a.ts and src//a.ts give one result; ../x is rejected",
    "input": {
      "same": [
        "./src/a.ts",
        "src/a.ts",
        "src//a.ts"
      ],
      "rejected": "../x"
    },
    "expected_normalized": "src/a.ts",
    "expected_error": "path_traversal"
  },
